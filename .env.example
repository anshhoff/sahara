# Razorpay TEST MODE ONLY. Never put live keys here. (docs/02 §2, docs/10 §10)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ----------------------------------------------------------------- LLM provider
# Three modes, all free, all reached through the same `openai` client (docs/10 §5):
#
#   openai_compat  a hosted OpenAI-compatible free tier   <- nothing runs on your machine
#   ollama         a local open-weights model             <- needs ~8 GB RAM free
#   none           no model at all; ambiguous cases stop  <- zero setup, always works
#
# Verify whatever you set with:  python scripts/check_llm.py
#
# Model ids and free-tier limits change often — copy the current id from your
# provider's own model page rather than from any documentation, including these docs.

LLM_PROVIDER=openai_compat

# --- Option A: Groq — free tier, fast, no card required
#     keys   https://console.groq.com/keys
#     models https://console.groq.com/docs/models   <- copy a current id from here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=PUT_A_CURRENT_GROQ_MODEL_ID_HERE
LLM_API_KEY=gsk_your_free_groq_key

# --- Option B: OpenRouter — models tagged ":free" cost nothing
#     keys   https://openrouter.ai/keys
#     models https://openrouter.ai/models?q=free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=PUT_A_CURRENT_FREE_OPENROUTER_MODEL_ID_HERE
# LLM_API_KEY=sk-or-v1-your_free_key

# --- Option C: Google AI Studio (Gemini) — free daily quota
#     keys   https://aistudio.google.com/apikey
#     docs   https://ai.google.dev/gemini-api/docs/openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=PUT_A_CURRENT_GEMINI_MODEL_ID_HERE
# LLM_API_KEY=your_free_ai_studio_key

# --- Option D: local Ollama (needs the RAM)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# --- Option E: no model at all — reproduces the full batch with zero setup
# LLM_PROVIDER=none

# ---------------------------------------------------------------------- optional
DB_PATH=recovery.db
LLM_COPY_ENABLED=true
LIVE_LINKS_MAX=5
