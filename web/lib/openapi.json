{
  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "holdout": {
            "default": 0.35,
            "description": "fraction of cases assigned to the untouched control arm",
            "maximum": 0.6,
            "minimum": 0.0,
            "title": "Holdout",
            "type": "number"
          },
          "live_links": {
            "default": 0,
            "description": "real test-mode Payment Links to spend; 0 keeps the run offline",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Live Links",
            "type": "integer"
          },
          "n": {
            "default": 80,
            "maximum": 400.0,
            "minimum": 10.0,
            "title": "N",
            "type": "integer"
          },
          "seed": {
            "default": 42,
            "title": "Seed",
            "type": "integer"
          }
        },
        "title": "BatchRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InjectRequest": {
        "properties": {
          "amount_rupees": {
            "default": 499.0,
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Amount Rupees",
            "type": "number"
          },
          "category": {
            "default": "card_expired",
            "title": "Category",
            "type": "string"
          }
        },
        "title": "InjectRequest",
        "type": "object"
      },
      "StormRequest": {
        "properties": {
          "distinct": {
            "default": false,
            "description": "false: n copies of ONE event (delivery retry). true: n different events for one subscription (a burst of real failures).",
            "title": "Distinct",
            "type": "boolean"
          },
          "n": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 2.0,
            "title": "N",
            "type": "integer"
          }
        },
        "title": "StormRequest",
        "type": "object"
      },
      "TestsRequest": {
        "properties": {
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "a single test file under tests/, or null for the whole suite",
            "title": "Path"
          }
        },
        "title": "TestsRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
