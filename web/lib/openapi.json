    "/api/audit/verify": {
      "get": {
        "description": "Recompute the audit log's hash chain and report the first break, if any.\n\nThis is the endpoint that makes \"append-only\" checkable by someone who does not\ntrust the code: edit one summary in the database with sqlite3 and this turns red,\nnaming the row. `head` is a one-line fingerprint of the whole run.",
        "operationId": "audit_verify_api_audit_verify_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Audit Verify Api Audit Verify Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Audit Verify",
        "tags": [
          "dashboard"
        ]
      }
    },
